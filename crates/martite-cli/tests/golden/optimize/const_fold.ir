ir-format 1
sources:
  #0 "std/env.mti"
  #1 "std/io.mti"
  #2 "const_fold.mt"
grants:
  "std.io"
  "std.env"
hosts:
  #0 name="args" module="std.env" params=[] ret=ty#7 opaque=-
  #1 name="get" module="std.env" params=[ty#2] ret=ty#8 opaque=-
  #2 name="read_line" module="std.io" params=[] ret=ty#9 opaque=-
  #3 name="read_file" module="std.io" params=[ty#2] ret=ty#10 opaque=-
  #4 name="write_file" module="std.io" params=[ty#2, ty#2] ret=ty#11 opaque=-
entries:
  kind=script
  main=fn#5
  tests=[]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=-
  json=type#0
consts:
  #0 int 1
  #1 int 2
  #2 int 3
  #3 int 4
  #4 int 2
  #5 int 5
  #6 int 9
  #7 int 7
  #8 int -5
strings:
  (none)

fn #0 "args" kind=host(host#0) source=src#0("std/env.mti") slots=0 ret=ty#7 body=-

fn #1 "get" kind=host(host#1) source=src#0("std/env.mti") slots=1 ret=ty#8 body=-
  params:
    slot=#0 name="name" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="name"

fn #2 "read_line" kind=host(host#2) source=src#1("std/io.mti") slots=0 ret=ty#9 body=-

fn #3 "read_file" kind=host(host#3) source=src#1("std/io.mti") slots=1 ret=ty#10 body=-
  params:
    slot=#0 name="path" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="path"

fn #4 "write_file" kind=host(host#4) source=src#1("std/io.mti") slots=2 ret=ty#11 body=-
  params:
    slot=#0 name="path" ty=ty#2 mut=no self=no pattern=-
    slot=#1 name="text" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="path"
    #1 ty=ty#2 mut=no name="text"

fn #5 "main" kind=free source=src#2("const_fold.mt") slots=1 ret=ty#6 body=#0
  slots:
    #0 ty=ty#12 mut=no name="value"
  patterns:
    #0 bind(slot=#0 ty=ty#12)
  nodes:
    #0 block stmts=[#1, #6] ty=ty#6 charge=0/0/0 effects=READS_LOCAL|WRITES_LOCAL|ALLOCATES|DYN_COST|SAFEPOINT|LOGS span=src#2:10..71 safepoint=1 origin=-
    #1 let pattern=#0 value=#2 ty=ty#6 charge=0/0/0 effects=WRITES_LOCAL|SAFEPOINT span=src#2:16..52 safepoint=1 origin=#0
    #2 expr_block stmts=[#4, #5] ty=ty#12 charge=1/0/0 effects=NONE span=src#2:29..52 safepoint=0 origin=#1
    #3 int const=#1 value=2 ty=ty#12 charge=1/0/0 effects=NONE span=src#2:29..52 safepoint=0 origin=#2
    #4 charge units=10 ty=ty#6 charge=0/0/0 effects=NONE span=src#2:29..52 safepoint=0 origin=#2
    #5 expr_stmt value=#3 ty=ty#6 charge=0/0/0 effects=NONE span=src#2:29..52 safepoint=0 origin=#2
    #6 expr_stmt value=#7 ty=ty#6 charge=0/0/0 effects=READS_LOCAL|ALLOCATES|DYN_COST|SAFEPOINT|LOGS span=src#2:57..69 safepoint=0 origin=#0
    #7 call_builtin_fn builtin=#0 first_arg=2 ty=ty#6 charge=1/0/0 effects=READS_LOCAL|ALLOCATES|DYN_COST|SAFEPOINT|LOGS span=src#2:57..69 safepoint=1 origin=#6
    #8 slot_read slot=#0 mode=share ty=ty#12 charge=1/0/0 effects=READS_LOCAL span=src#2:63..68 safepoint=0 origin=#7
