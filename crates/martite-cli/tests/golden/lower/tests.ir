ir-format 1
sources:
  #0 "std/env.mti"
  #1 "std/io.mti"
  #2 "tests.mt"
grants:
  "std.io"
  "std.env"
hosts:
  #0 name="args" module="std.env" params=[] ret=ty#7 opaque=-
  #1 name="get" module="std.env" params=[ty#2] ret=ty#8 opaque=-
  #2 name="read_line" module="std.io" params=[] ret=ty#9 opaque=-
  #3 name="read_file" module="std.io" params=[ty#2] ret=ty#10 opaque=-
  #4 name="write_file" module="std.io" params=[ty#2, ty#2] ret=ty#11 opaque=-
entries:
  kind=script
  main=fn#8
  tests=[fn#6, fn#7]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=-
  json=type#0
consts:
  #0 int 2
  #1 int 3
  #2 int 5
  #3 int 3
  #4 int 1
  #5 int 2
  #6 int 1
  #7 int 2
  #8 int 3
  #9 int 20
  #10 int 22
strings:
  #0 "2 + 3 should be 5"
  #1 "list was not sorted"

fn #0 "args" kind=host(host#0) source=src#0("std/env.mti") slots=0 ret=ty#7 body=-

fn #1 "get" kind=host(host#1) source=src#0("std/env.mti") slots=1 ret=ty#8 body=-
  params:
    slot=#0 name="name" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="name"

fn #2 "read_line" kind=host(host#2) source=src#1("std/io.mti") slots=0 ret=ty#9 body=-

fn #3 "read_file" kind=host(host#3) source=src#1("std/io.mti") slots=1 ret=ty#10 body=-
  params:
    slot=#0 name="path" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="path"

fn #4 "write_file" kind=host(host#4) source=src#1("std/io.mti") slots=2 ret=ty#11 body=-
  params:
    slot=#0 name="path" ty=ty#2 mut=no self=no pattern=-
    slot=#1 name="text" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="path"
    #1 ty=ty#2 mut=no name="text"

fn #5 "add" kind=free source=src#2("tests.mt") slots=2 ret=ty#12 body=#4
  params:
    slot=#0 name="a" ty=ty#12 mut=no self=no pattern=-
    slot=#1 name="b" ty=ty#12 mut=no self=no pattern=-
  slots:
    #0 ty=ty#12 mut=no name="a"
    #1 ty=ty#12 mut=no name="b"
  nodes:
    #0 slot_read slot=#0 mode=share ty=ty#12 charge=1/0/0 effects=READS_LOCAL span=src#2:32..33 safepoint=0 origin=-
    #1 slot_read slot=#1 mode=share ty=ty#12 charge=1/0/0 effects=READS_LOCAL span=src#2:36..37 safepoint=0 origin=-
    #2 add lhs=#0 rhs=#1 ty=ty#12 charge=1/0/0 effects=MAY_TRAP|READS_LOCAL|PANICS span=src#2:32..37 safepoint=0 origin=-
    #3 expr_stmt value=#2 ty=ty#6 charge=0/0/0 effects=MAY_TRAP|READS_LOCAL|PANICS span=src#2:32..37 safepoint=0 origin=-
    #4 block stmts=[#3] ty=ty#12 charge=0/0/0 effects=MAY_TRAP|READS_LOCAL|SAFEPOINT|PANICS span=src#2:30..39 safepoint=1 origin=-

fn #6 "adds numbers" kind=test source=src#2("tests.mt") slots=0 ret=ty#6 body=#8
  nodes:
    #0 int const=#0 value=2 ty=ty#12 charge=1/0/0 effects=NONE span=src#2:74..75 safepoint=0 origin=-
