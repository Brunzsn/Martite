ir-format 1
sources:
  #0 "std/env.mti"
  #1 "std/io.mti"
  #2 "env.mt"
grants:
  "std.io"
  "std.env"
hosts:
  #0 name="args" module="std.env" params=[] ret=ty#7 opaque=-
  #1 name="get" module="std.env" params=[ty#2] ret=ty#8 opaque=-
  #2 name="read_line" module="std.io" params=[] ret=ty#9 opaque=-
  #3 name="read_file" module="std.io" params=[ty#2] ret=ty#10 opaque=-
  #4 name="write_file" module="std.io" params=[ty#2, ty#2] ret=ty#11 opaque=-
entries:
  kind=script
  main=fn#5
  tests=[]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=-
  json=type#0
consts:
  (none)
strings:
  #0 "args = "

fn #0 "args" kind=host(host#0) source=src#0("std/env.mti") slots=0 ret=ty#7 body=-

fn #1 "get" kind=host(host#1) source=src#0("std/env.mti") slots=1 ret=ty#8 body=-
  params:
    slot=#0 name="name" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="name"

fn #2 "read_line" kind=host(host#2) source=src#1("std/io.mti") slots=0 ret=ty#9 body=-

fn #3 "read_file" kind=host(host#3) source=src#1("std/io.mti") slots=1 ret=ty#10 body=-
  params:
    slot=#0 name="path" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="path"

fn #4 "write_file" kind=host(host#4) source=src#1("std/io.mti") slots=2 ret=ty#11 body=-
  params:
    slot=#0 name="path" ty=ty#2 mut=no self=no pattern=-
    slot=#1 name="text" ty=ty#2 mut=no self=no pattern=-
  slots:
    #0 ty=ty#2 mut=no name="path"
    #1 ty=ty#2 mut=no name="text"

fn #5 "main" kind=free source=src#2("env.mt") slots=1 ret=ty#6 body=#6
  slots:
    #0 ty=ty#7 mut=no name="args"
  patterns:
    #0 bind(slot=#0 ty=ty#7)
  str_parts:
    #0 text str#0("args = ")
    #1 expr #2
  nodes:
    #0 call_host host=host#0 args=[] ty=ty#7 charge=1/0/0 effects=MAY_TRAP|SHARES|ALLOCATES|DYN_COST|SAFEPOINT|HOST span=src#2:40..50 safepoint=1 origin=-
    #1 let pattern=#0 value=#0 ty=ty#6 charge=0/0/0 effects=MAY_TRAP|WRITES_LOCAL|SHARES|ALLOCATES|DYN_COST|SAFEPOINT|HOST span=src#2:29..50 safepoint=1 origin=-
    #2 slot_read slot=#0 mode=share ty=ty#7 charge=1/0/0 effects=READS_LOCAL|SHARES span=src#2:70..74 safepoint=0 origin=-
    #3 str_interp parts=[text str#0("args = "), expr #2] ty=ty#2 charge=1/0/0 effects=READS_LOCAL|SHARES|ALLOCATES|DYN_COST span=src#2:61..76 safepoint=0 origin=-
    #4 call_builtin_fn builtin=#0 first_arg=0 ty=ty#6 charge=1/0/0 effects=READS_LOCAL|SHARES|ALLOCATES|DYN_COST|SAFEPOINT|LOGS span=src#2:55..77 safepoint=1 origin=-
    #5 expr_stmt value=#4 ty=ty#6 charge=0/0/0 effects=READS_LOCAL|SHARES|ALLOCATES|DYN_COST|SAFEPOINT|LOGS span=src#2:55..77 safepoint=0 origin=-
    #6 block stmts=[#1, #5] ty=ty#6 charge=0/0/0 effects=MAY_TRAP|READS_LOCAL|WRITES_LOCAL|SHARES|ALLOCATES|DYN_COST|SAFEPOINT|HOST|LOGS span=src#2:23..79 safepoint=1 origin=-
