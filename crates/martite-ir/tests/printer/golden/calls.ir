ir-format 1
sources:
  #0 "calls.mt"
grants:
  "std.io"
hosts:
  #0 name="log" module="std.io" params=[ty#0] ret=ty#1 opaque=-
entries:
  kind=script
  main=fn#0
  tests=[fn#0]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=ty#0
  json=type#0
consts:
  #0 int 1
  #1 int 2
strings:
  (none)

fn #0 "fib" kind=free source=src#0("calls.mt") slots=1 ret=ty#0 body=#16
  params:
    slot=#0 name="n" ty=ty#0 mut=no self=no pattern=-
  slots:
    #0 ty=ty#0 mut=no name="n"
  nodes:
    #0 slot_read slot=#0 mode=share ty=ty#0 charge=1/0/0 effects=READS_LOCAL|SHARES span=src#0:0..1 safepoint=0 origin=-
    #1 int const=#0 value=1 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:1..2 safepoint=0 origin=-
    #2 lt lhs=#0 rhs=#1 ty=ty#0 charge=1/0/0 effects=MAY_TRAP span=src#0:2..3 safepoint=0 origin=-
    #3 return value=#0 ty=ty#1 charge=0/0/0 effects=READS_LOCAL span=src#0:3..4 safepoint=0 origin=-
    #4 slot_read slot=#0 mode=share ty=ty#0 charge=1/0/0 effects=READS_LOCAL|SHARES span=src#0:4..5 safepoint=0 origin=-
    #5 int const=#0 value=1 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:5..6 safepoint=0 origin=-
    #6 sub lhs=#4 rhs=#5 ty=ty#0 charge=1/0/0 effects=MAY_TRAP span=src#0:6..7 safepoint=0 origin=-
    #7 call_direct target=fn#0 args=[#6] ty=ty#0 charge=1/0/0 effects=MAY_TRAP|DYN_COST|CALLS span=src#0:7..8 safepoint=0 origin=-
    #8 slot_read slot=#0 mode=share ty=ty#0 charge=1/0/0 effects=READS_LOCAL|SHARES span=src#0:8..9 safepoint=0 origin=-
    #9 int const=#1 value=2 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:9..10 safepoint=0 origin=-
    #10 sub lhs=#8 rhs=#9 ty=ty#0 charge=1/0/0 effects=MAY_TRAP span=src#0:10..11 safepoint=0 origin=-
    #11 call_direct target=fn#0 args=[#10] ty=ty#0 charge=1/0/0 effects=MAY_TRAP|DYN_COST|CALLS span=src#0:11..12 safepoint=0 origin=-
    #12 add lhs=#7 rhs=#11 ty=ty#0 charge=1/0/0 effects=MAY_TRAP|DYN_COST|CALLS span=src#0:12..13 safepoint=0 origin=-
    #13 return value=#12 ty=ty#1 charge=0/0/0 effects=MAY_TRAP|DYN_COST|CALLS span=src#0:13..14 safepoint=0 origin=-
    #14 block stmts=[#3] ty=ty#0 charge=0/0/0 effects=READS_LOCAL span=src#0:14..15 safepoint=0 origin=-
    #15 block stmts=[#13] ty=ty#0 charge=0/0/0 effects=MAY_TRAP|DYN_COST|CALLS span=src#0:15..16 safepoint=0 origin=-
    #16 if condition=#2 then=#14 else=#15 ty=ty#0 charge=1/0/0 effects=MAY_TRAP|READS_LOCAL|DYN_COST|CALLS span=src#0:16..17 safepoint=0 origin=-
