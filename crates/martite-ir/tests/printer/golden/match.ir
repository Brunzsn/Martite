ir-format 1
sources:
  #0 "match.mt"
grants:
  (none)
hosts:
  (none)
entries:
  kind=script
  main=fn#0
  tests=[]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=-
  json=-
consts:
  #0 int 1
strings:
  (none)

fn #0 "classify" kind=free source=src#0("match.mt") slots=1 body=#5
  params:
    slot=#0 name="value" ty=ty#0 mut=no self=no pattern=-
  slots:
    #0 ty=ty#0 mut=no name="value"
  patterns:
    #0 int 1
    #1 wild
  matches:
    #0
      arm pattern=#0 guard=- body=#3
      arm pattern=#1 guard=#2 body=#4
  nodes:
    #0 slot_read slot=#0 mode=share ty=ty#0 charge=1/0/0 effects=READS_LOCAL|SHARES span=src#0:0..1 origin=-
    #1 int const=#0 value=1 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:1..2 origin=-
    #2 eq lhs=#0 rhs=#1 ty=ty#0 charge=1/0/0 effects=MAY_TRAP span=src#0:2..3 origin=-
    #3 return value=#0 ty=ty#1 charge=0/0/0 effects=READS_LOCAL span=src#0:3..4 origin=-
    #4 return value=- ty=ty#1 charge=0/0/0 effects=NONE span=src#0:4..5 origin=-
    #5 match match_set=#0 scrutinee=#0 ty=ty#0 charge=1/0/0 effects=MAY_TRAP|READS_LOCAL span=src#0:5..6 origin=-
