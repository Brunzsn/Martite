ir-format 1
sources:
  #0 "mut_params.mt"
grants:
  (none)
hosts:
  (none)
entries:
  kind=script
  main=fn#1
  tests=[]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=-
  json=-
consts:
  #0 int 1
strings:
  (none)

fn #0 "bump" kind=free source=src#0("mut_params.mt") slots=1 body=#1
  params:
    slot=#0 name="value" ty=ty#0 mut=yes self=no pattern=-
  slots:
    #0 ty=ty#0 mut=yes name="value"
  nodes:
    #0 int const=#0 value=1 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:0..1 origin=-
    #1 slot_write slot=#0 value=#0 ty=ty#0 charge=0/0/0 effects=WRITES_LOCAL span=src#0:1..2 origin=-

fn #1 "main" kind=free source=src#0("mut_params.mt") slots=1 body=#3
  slots:
    #0 ty=ty#0 mut=yes name="value"
  nodes:
    #0 slot_place slot=#0 ty=ty#0 charge=0/0/0 effects=NONE span=src#0:0..1 origin=-
    #1 mut_arg place=#0 ty=ty#0 charge=0/0/0 effects=NONE span=src#0:1..2 origin=-
    #2 call_direct target=fn#0 args=[#1] ty=ty#0 charge=1/0/0 effects=MAY_TRAP|CALLS span=src#0:2..3 origin=-
    #3 expr_stmt value=#2 ty=ty#1 charge=0/0/0 effects=MAY_TRAP|CALLS span=src#0:3..4 origin=-
