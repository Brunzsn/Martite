ir-format 1
sources:
  #0 "loops.mt"
grants:
  (none)
hosts:
  (none)
entries:
  kind=script
  main=fn#0
  tests=[]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=-
  json=-
consts:
  #0 int 0
  #1 int 1
strings:
  (none)

fn #0 "main" kind=free source=src#0("loops.mt") slots=1 ret=ty#1 body=#10
  slots:
    #0 ty=ty#0 mut=no name=-
  patterns:
    #0 bind(slot=#0 ty=ty#0)
  nodes:
    #0 bool value=true ty=ty#0 charge=1/0/0 effects=NONE span=src#0:0..1 safepoint=0 origin=-
    #1 break ty=ty#1 charge=0/0/0 effects=NONLOCAL_EXIT span=src#0:1..2 safepoint=0 origin=-
    #2 block stmts=[#1] ty=ty#1 charge=0/0/0 effects=NONLOCAL_EXIT span=src#0:2..3 safepoint=0 origin=-
    #3 while condition=#0 body=#2 ty=ty#1 charge=1/0/1 effects=NONLOCAL_EXIT span=src#0:3..4 safepoint=0 origin=-
    #4 int const=#0 value=0 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:4..5 safepoint=0 origin=-
    #5 int const=#1 value=1 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:5..6 safepoint=0 origin=-
    #6 list items=[#4, #5] ty=ty#0 charge=1/2/0 effects=ALLOCATES span=src#0:6..7 safepoint=0 origin=-
    #7 continue ty=ty#1 charge=0/0/0 effects=NONLOCAL_EXIT span=src#0:7..8 safepoint=0 origin=-
    #8 block stmts=[#7] ty=ty#1 charge=0/0/0 effects=NONLOCAL_EXIT span=src#0:8..9 safepoint=0 origin=-
    #9 for pattern=#0 iter=#6 body=#8 ty=ty#1 charge=1/0/1 effects=NONLOCAL_EXIT span=src#0:9..10 safepoint=0 origin=-
    #10 block stmts=[#3, #9] ty=ty#1 charge=0/0/0 effects=NONLOCAL_EXIT span=src#0:10..11 safepoint=0 origin=-
