ir-format 1
sources:
  #0 "literals.mt"
grants:
  (none)
hosts:
  (none)
entries:
  kind=script
  main=fn#0
  tests=[]
  handlers=[]
  hooks=[]
  init=-
  shutdown=-
  state=-
  json=-
consts:
  #0 int 7
  #1 float 2.5
  #2 bool true
strings:
  #0 "hello"

fn #0 "main" kind=free source=src#0("literals.mt") slots=1 ret=ty#0 body=#5
  slots:
    #0 ty=ty#0 mut=no name=-
  nodes:
    #0 int const=#0 value=7 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:0..1 safepoint=0 origin=-
    #1 float const=#1 value=2.5 ty=ty#0 charge=1/0/0 effects=NONE span=src#0:1..2 safepoint=0 origin=-
    #2 bool value=true ty=ty#0 charge=1/0/0 effects=NONE span=src#0:2..3 safepoint=0 origin=-
    #3 str#0("hello") ty=ty#0 charge=1/0/0 effects=NONE span=src#0:3..4 safepoint=0 origin=-
    #4 tuple items=[#0, #1, #2, #3] ty=ty#0 charge=1/4/0 effects=ALLOCATES span=src#0:4..5 safepoint=0 origin=-
    #5 return value=#4 ty=ty#1 charge=0/0/0 effects=NONE span=src#0:5..6 safepoint=1 origin=-
